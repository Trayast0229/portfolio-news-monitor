# Copy to backend/.env. Leave the key empty to use FinBERT only.
ANTHROPIC_API_KEY=

# Optional: a different Claude model (default: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Set to 0 to skip loading FinBERT when the server starts
# FINBERT_PRELOAD=1

# Only when the frontend is hosted on another site: the exact sites allowed to call this API
# from a browser, comma-separated, e.g. https://portfolio-news.pages.dev
# Leave unset for local development (the dev server's proxy makes it the same site).
# ALLOWED_ORIGINS=
